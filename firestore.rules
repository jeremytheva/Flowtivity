/**
 * @fileoverview Firestore Security Rules for SoloStrategist OS.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model, where users can only
 * read and write their own data, with the exception of public read access for
 * certain collections.
 *
 * Data Structure:
 * - User profiles are stored under /users/{userId}, with each document keyed
 *   by the user's UID.
 * - Tasks are stored under /tasks/{taskId}. Each task contains a userId
 *   field indicating the owner.
 * - Metrics data are stored under /metrics/{userId}. Each metric document contains a userId
 *   field indicating the owner.
 * - Coaching history is stored under /coachingHistory/{historyId}. Each document contains a userId
 *   field indicating the owner.
 * - Tool usage logs are stored under /toolUsageLogs/{logId}. Each document contains a userId
 *   field indicating the owner.
 *
 * Key Security Decisions:
 * - Users can only create, update, and delete their own user profile.
 * - Listing of users is not allowed.
 * - Public read access is enabled for the tasks, metrics, coachingHistory and toolUsageLogs collections.
 * - All write operations are restricted to the owner of the document, based on the userId field.
 *
 * Denormalization for Authorization:
 * - The 'Task', 'MetricsData', 'CoachingHistory', and 'ToolUsageLog' entities include a 'userId' field,
 *   which is used to enforce ownership for write operations. This avoids the need
 *   for complex queries or additional reads to determine ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (read) Authenticated user can read their own profile.
     * @allow (create) Authenticated user can create their own profile if the userId matches their auth.uid.
     * @allow (update) Authenticated user can update their own profile if the userId matches their auth.uid.
     * @deny (delete) No one can delete a user profile.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId} {
      // Only signed-in users can read user profiles.
      allow get: if isSignedIn() && isOwner(userId);
      // No listing of user documents.
      allow list: if false;
      // Only signed-in users can create their own profile, and the userId must match their auth UID.
      allow create: if isSignedIn() && isOwner(userId);
      // Only the user can update their own profile, and the userId must match their auth UID.
      allow update: if isSignedIn() && isExistingOwner(userId);
      // No one can delete a user profile.
      allow delete: if false;
    }

    /**
     * @description Rules for tasks.
     * @path /tasks/{taskId}
     * @allow (get, list) Any user can read any task.
     * @allow (create) Only an authenticated user can create a task, and the userId in the task must match their auth.uid.
     * @allow (update) Only the owner of the task can update it.
     * @allow (delete) Only the owner of the task can delete it.
     * @principle Allows public reads, but restricts writes to the owner of the document.
     */
    match /tasks/{taskId} {
      // Anyone can read tasks.
      allow get, list: if true;
      // Only signed-in users can create tasks, and the userId in the task must match their auth UID.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Only the owner can update the task, and the task must exist.
      allow update: if isSignedIn() && isExistingOwner(resource.data.userId);
      // Only the owner can delete the task, and the task must exist.
      allow delete: if isSignedIn() && isExistingOwner(resource.data.userId);
    }

        /**
     * @description Rules for metrics data.
     * @path /metrics/{metricId}
     * @allow (get, list) Any user can read any metrics data.
     * @allow (create) Only an authenticated user can create metrics data, and the userId in the document must match their auth.uid.
     * @allow (update) Only the owner of the metrics data can update it.
     * @allow (delete) Only the owner of the metrics data can delete it.
     * @principle Allows public reads, but restricts writes to the owner of the document.
     */
    match /metrics/{metricId} {
      // Anyone can read metrics.
      allow get, list: if true;
      // Only signed-in users can create metrics, and the userId in the document must match their auth UID.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Only the owner can update the metrics, and the metrics data must exist.
      allow update: if isSignedIn() && isExistingOwner(resource.data.userId);
      // Only the owner can delete the metrics, and the metrics data must exist.
      allow delete: if isSignedIn() && isExistingOwner(resource.data.userId);
    }

    /**
     * @description Rules for coaching history.
     * @path /coachingHistory/{historyId}
     * @allow (get, list) Any user can read any coaching history.
     * @allow (create) Only an authenticated user can create a coaching history entry, and the userId in the document must match their auth.uid.
     * @allow (update) Only the owner of the coaching history entry can update it.
     * @allow (delete) Only the owner of the coaching history entry can delete it.
     * @principle Allows public reads, but restricts writes to the owner of the document.
     */
    match /coachingHistory/{historyId} {
      // Anyone can read coaching history.
      allow get, list: if true;
      // Only signed-in users can create coaching history, and the userId in the document must match their auth UID.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Only the owner can update the coaching history, and the history entry must exist.
      allow update: if isSignedIn() && isExistingOwner(resource.data.userId);
      // Only the owner can delete the coaching history, and the history entry must exist.
      allow delete: if isSignedIn() && isExistingOwner(resource.data.userId);
    }

   /**
     * @description Rules for tool usage logs.
     * @path /toolUsageLogs/{logId}
     * @allow (get, list) Any user can read any tool usage logs.
     * @allow (create) Only an authenticated user can create a tool usage log entry, and the userId in the document must match their auth.uid.
     * @allow (update) Only the owner of the tool usage log entry can update it.
     * @allow (delete) Only the owner of the tool usage log entry can delete it.
     * @principle Allows public reads, but restricts writes to the owner of the document.
     */
    match /toolUsageLogs/{logId} {
      // Anyone can read tool usage logs.
      allow get, list: if true;
      // Only signed-in users can create tool usage logs, and the userId in the document must match their auth UID.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Only the owner can update the tool usage logs, and the log entry must exist.
      allow update: if isSignedIn() && isExistingOwner(resource.data.userId);
      // Only the owner can delete the tool usage logs, and the log entry must exist.
      allow delete: if isSignedIn() && isExistingOwner(resource.data.userId);
    }
  }

  // Helper function to determine if the user is signed in.
  function isSignedIn() {
    return request.auth != null;
  }

  // Helper function to determine if the user is the owner of the document.
  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  // Helper function to determine if the user is the owner of the existing document.
  function isExistingOwner(userId) {
      return isSignedIn() && isOwner(userId) && resource != null;
  }
}