/**
 * @fileOverview Firestore Security Rules for SoloStrategist OS.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Each user can only access their own profile data and associated subcollections.
 *
 * Data Structure:
 * All data is nested under /users/{userId}. Each user has a profile document and can have multiple tasks, metrics, coaching history entries, and tool usage logs.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Listing all users is disallowed.
 * - All subcollections are also user-owned.
 *
 * Denormalization for Authorization:
 * - The `userProfileId` field in subcollections is used to ensure that only the owner of the profile can access the subcollection data. This duplicates the `userId` in the path, but avoids needing to perform costly `get()` operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles. Only the authenticated user can read or write their own profile.
     * @path /users/{userId}
     * @allow (get) User with ID 'user123' can read their own profile.
     *   Request: auth.uid = 'user123'
     * @allow (create) User with ID 'user123' can create their own profile.
     *   Request: auth.uid = 'user123'
     * @allow (update) User with ID 'user123' can update their own profile.
     *   Request: auth.uid = 'user123'
     * @allow (delete) User with ID 'user123' can delete their own profile.
     *   Request: auth.uid = 'user123'
     * @deny (get) User with ID 'user456' cannot read user 'user123' profile.
     *   Request: auth.uid = 'user456'
     * @deny (create) User with ID 'user456' cannot create user 'user123' profile.
     *   Request: auth.uid = 'user456'
     * @deny (update) User with ID 'user456' cannot update user 'user123' profile.
     *   Request: auth.uid = 'user456'
     * @deny (delete) User with ID 'user456' cannot delete user 'user123' profile.
     *   Request: auth.uid = 'user456'
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && resource != null;
      allow delete: if isOwner(userId) && resource != null;
    }

    /**
     * @description Secure tasks under a user profile. Only the authenticated user (owner of the profile) can read or write tasks.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (get) User with ID 'user123' can read their own task 'task456'.
     *   Request: auth.uid = 'user123'
     * @allow (create) User with ID 'user123' can create a task under their profile.
     *   Request: auth.uid = 'user123', request.resource.data.userProfileId = 'user123'
     * @allow (update) User with ID 'user123' can update their own task 'task456'.
     *   Request: auth.uid = 'user123', resource.data.userProfileId = 'user123'
     * @allow (delete) User with ID 'user123' can delete their own task 'task456'.
     *   Request: auth.uid = 'user123', resource.data.userProfileId = 'user123'
     * @deny (get) User with ID 'user456' cannot read task 'task456' under user 'user123'.
     *   Request: auth.uid = 'user456'
     * @deny (create) User with ID 'user456' cannot create a task under user 'user123'.
     *   Request: auth.uid = 'user456', request.resource.data.userProfileId = 'user123'
     * @deny (update) User with ID 'user456' cannot update task 'task456' under user 'user123'.
     *   Request: auth.uid = 'user456', resource.data.userProfileId = 'user123'
     * @deny (delete) User with ID 'user456' cannot delete task 'task456' under user 'user123'.
     *   Request: auth.uid = 'user456', resource.data.userProfileId = 'user123'
     * @principle Enforces document ownership and validates the userProfileId on write.
     */
    match /users/{userId}/tasks/{taskId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userProfileId == userId;
      allow update: if isOwner(userId) && resource.data.userProfileId == userId && resource != null;
      allow delete: if isOwner(userId) && resource.data.userProfileId == userId && resource != null;
    }

    /**
     * @description Secure metrics data under a user profile. Only the authenticated user (owner of the profile) can read or write metrics data.
     * @path /users/{userId}/metrics/{metricId}
     * @allow (get) User with ID 'user123' can read their own metrics 'metric456'.
     *   Request: auth.uid = 'user123'
     * @allow (create) User with ID 'user123' can create metrics data under their profile.
     *   Request: auth.uid = 'user123', request.resource.data.userProfileId = 'user123'
     * @allow (update) User with ID 'user123' can update their own metrics 'metric456'.
     *   Request: auth.uid = 'user123', resource.data.userProfileId = 'user123'
     * @allow (delete) User with ID 'user123' can delete their own metrics 'metric456'.
     *   Request: auth.uid = 'user123', resource.data.userProfileId = 'user123'
     * @deny (get) User with ID 'user456' cannot read metrics 'metric456' under user 'user123'.
     *   Request: auth.uid = 'user456'
     * @deny (create) User with ID 'user456' cannot create metrics data under user 'user123'.
     *   Request: auth.uid = 'user456', request.resource.data.userProfileId = 'user123'
     * @deny (update) User with ID 'user456' cannot update metrics 'metric456' under user 'user123'.
     *   Request: auth.uid = 'user456', resource.data.userProfileId = 'user123'
     * @deny (delete) User with ID 'user456' cannot delete metrics 'metric456' under user 'user123'.
     *   Request: auth.uid = 'user456', resource.data.userProfileId = 'user123'
     * @principle Enforces document ownership and validates the userProfileId on write.
     */
    match /users/{userId}/metrics/{metricId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userProfileId == userId;
      allow update: if isOwner(userId) && resource.data.userProfileId == userId && resource != null;
      allow delete: if isOwner(userId) && resource.data.userProfileId == userId && resource != null;
    }

    /**
     * @description Secure coaching history under a user profile. Only the authenticated user (owner of the profile) can read or write coaching history.
     * @path /users/{userId}/coachingHistory/{historyId}
     * @allow (get) User with ID 'user123' can read their own history 'history456'.
     *   Request: auth.uid = 'user123'
     * @allow (create) User with ID 'user123' can create coaching history under their profile.
     *   Request: auth.uid = 'user123', request.resource.data.userProfileId = 'user123'
     * @allow (update) User with ID 'user123' can update their own history 'history456'.
     *   Request: auth.uid = 'user123', resource.data.userProfileId = 'user123'
     * @allow (delete) User with ID 'user123' can delete their own history 'history456'.
     *   Request: auth.uid = 'user123', resource.data.userProfileId = 'user123'
     * @deny (get) User with ID 'user456' cannot read history 'history456' under user 'user123'.
     *   Request: auth.uid = 'user456'
     * @deny (create) User with ID 'user456' cannot create coaching history under user 'user123'.
     *   Request: auth.uid = 'user456', request.resource.data.userProfileId = 'user123'
     * @deny (update) User with ID 'user456' cannot update history 'history456' under user 'user123'.
     *   Request: auth.uid = 'user456', resource.data.userProfileId = 'user123'
     * @deny (delete) User with ID 'user456' cannot delete history 'history456' under user 'user123'.
     *   Request: auth.uid = 'user456', resource.data.userProfileId = 'user123'
     * @principle Enforces document ownership and validates the userProfileId on write.
     */
    match /users/{userId}/coachingHistory/{historyId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userProfileId == userId;
      allow update: if isOwner(userId) && resource.data.userProfileId == userId && resource != null;
      allow delete: if isOwner(userId) && resource.data.userProfileId == userId && resource != null;
    }

    /**
     * @description Secure tool usage logs under a user profile. Only the authenticated user (owner of the profile) can read or write tool usage logs.
     * @path /users/{userId}/toolUsageLogs/{logId}
     * @allow (get) User with ID 'user123' can read their own log 'log456'.
     *   Request: auth.uid = 'user123'
     * @allow (create) User with ID 'user123' can create tool usage logs under their profile.
     *   Request: auth.uid = 'user123', request.resource.data.userProfileId = 'user123'
     * @allow (update) User with ID 'user123' can update their own log 'log456'.
     *   Request: auth.uid = 'user123', resource.data.userProfileId = 'user123'
     * @allow (delete) User with ID 'user123' can delete their own log 'log456'.
     *   Request: auth.uid = 'user123', resource.data.userProfileId = 'user123'
     * @deny (get) User with ID 'user456' cannot read log 'log456' under user 'user123'.
     *   Request: auth.uid = 'user456'
     * @deny (create) User with ID 'user456' cannot create tool usage logs under user 'user123'.
     *   Request: auth.uid = 'user456', request.resource.data.userProfileId = 'user123'
     * @deny (update) User with ID 'user456' cannot update log 'log456' under user 'user123'.
     *   Request: auth.uid = 'user456', resource.data.userProfileId = 'user123'
     * @deny (delete) User with ID 'user456' cannot delete log 'log456' under user 'user123'.
     *   Request: auth.uid = 'user456', resource.data.userProfileId = 'user123'
     * @principle Enforces document ownership and validates the userProfileId on write.
     */
    match /users/{userId}/toolUsageLogs/{logId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userProfileId == userId;
      allow update: if isOwner(userId) && resource.data.userProfileId == userId && resource != null;
      allow delete: if isOwner(userId) && resource.data.userProfileId == userId && resource != null;
    }
  }
}