/**
 * @fileoverview Firestore Security Rules for SoloStrategist OS.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Each user has full
 * control over their own profile and associated data (tasks, metrics, coaching history,
 * tool usage logs). No cross-user data access is permitted except where explicitly
 * configured.
 *
 * Data Structure:
 * All data is nested under /users/{userId}, ensuring clear ownership.
 *  - /users/{userId} (UserProfile)
 *  - /users/{userId}/tasks/{taskId} (Task)
 *  - /users/{userId}/metrics/{metricId} (MetricsData)
 *  - /users/{userId}/coachingHistory/{historyId} (CoachingHistory)
 *  - /users/{userId}/toolUsageLogs/{logId} (ToolUsageLog)
 *
 * Key Security Decisions:
 *  - User profiles can only be created by themselves and updated by themselves.
 *  - Data consistency is enforced: the {userId} path segment must match the
 *    'id' field within the UserProfile document. This ensures a user cannot
 *    impersonate or spoof another user's data.
 *  - Listing of user profiles is disallowed. This prevents enumeration attacks
 *    and protects user privacy.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if the authenticated user is the owner of the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Helper function to check if the authenticated user is the owner of the existing document
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Controls access to user profile documents.
     * @path /databases/{database}/documents/users/{userId}
     * @allow (create) User with UID 'userId' can create their own profile.
     * @allow (update) User with UID 'userId' can update their own profile.
     * @deny  (create) User tries to create a profile with an ID different from their UID.
     * @deny  (update) User tries to update a profile that doesn't exist or isn't theirs.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if false;
      allow list: if false;

      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to tasks for a specific user.
     * @path /databases/{database}/documents/users/{userId}/tasks/{taskId}
     * @allow (create) User with UID 'userId' can create tasks under their profile.
     * @allow (update) User with UID 'userId' can update their own tasks.
     * @deny  (create) User tries to create a task for a different user.
     * @deny  (update) User tries to update a task that doesn't exist or isn't theirs.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/tasks/{taskId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userProfileId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userProfileId == userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to metrics data for a specific user.
     * @path /databases/{database}/documents/users/{userId}/metrics/{metricId}
     * @allow (create) User with UID 'userId' can create metrics data under their profile.
     * @allow (update) User with UID 'userId' can update their own metrics data.
     * @deny  (create) User tries to create metrics data for a different user.
     * @deny  (update) User tries to update metrics data that doesn't exist or isn't theirs.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/metrics/{metricId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userProfileId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userProfileId == userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to coaching history for a specific user.
     * @path /databases/{database}/documents/users/{userId}/coachingHistory/{historyId}
     * @allow (create) User with UID 'userId' can create coaching history under their profile.
     * @allow (update) User with UID 'userId' can update their own coaching history.
     * @deny  (create) User tries to create coaching history for a different user.
     * @deny  (update) User tries to update coaching history that doesn't exist or isn't theirs.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/coachingHistory/{historyId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userProfileId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userProfileId == userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to tool usage logs for a specific user.
     * @path /databases/{database}/documents/users/{userId}/toolUsageLogs/{logId}
     * @allow (create) User with UID 'userId' can create tool usage logs under their profile.
     * @allow (update) User with UID 'userId' can update their own tool usage logs.
     * @deny  (create) User tries to create tool usage logs for a different user.
     * @deny  (update) User tries to update tool usage logs that doesn't exist or isn't theirs.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/toolUsageLogs/{logId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userProfileId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userProfileId == userId;
      allow delete: if isExistingOwner(userId);
    }
  }
}