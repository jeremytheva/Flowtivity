/**
 * @fileoverview Firestore Security Rules for SoloStrategist OS.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for most data,
 * ensuring that only authenticated users can access their own data.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, keyed by UID.
 * - /tasks/{taskId}: Stores tasks for all users; documents contain a userId field.
 * - /metrics/{userId}: Stores metrics, keyed by UID.
 * - /coachingHistory/{historyId}: Stores coaching history; documents contain a userId field.
 * - /toolUsageLogs/{logId}: Stores tool usage logs; documents contain a userId field.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data in /users/{userId}.
 * - Tasks, metrics, coaching history, and tool usage logs are secured by requiring the userId
 *   field in the document to match the authenticated user's UID.
 * - No user listing is allowed for any collections.
 *
 * Denormalization for Authorization:
 * - Tasks, metrics, coaching history, and tool usage logs include a `userId` field to
 *   simplify authorization checks and avoid expensive `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own profile data.
     * @path /users/{userId}
     * @allow (create, update, get) User with UID 'user123' can create/update/get their profile at /users/user123.
     * @deny (create, update, get) User with UID 'user456' cannot create/update/get profile at /users/user123.
     * @principle Enforces document ownership for writes and reads.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Allows users to read and write tasks where they are the owner.
     * @path /tasks/{taskId}
     * @allow (create) User with UID 'user123' can create a task at /tasks/task456 if task.userId == 'user123'.
     * @allow (get, update, delete) User with UID 'user123' can read/update/delete a task at /tasks/task456 if task.userId == 'user123'.
     * @deny (create) User with UID 'user456' cannot create a task at /tasks/task456 with task.userId == 'user123'.
     * @deny (get, update, delete) User with UID 'user456' cannot read/update/delete a task at /tasks/task456 if task.userId == 'user123'.
     * @principle Enforces document ownership based on the userId field.
     */
    match /tasks/{taskId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

       function isExistingOwner(userId) {
        return isSignedIn() && resource.data.userId == request.auth.uid;
      }

      allow get: if isSignedIn() && isExistingOwner(resource.data.userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      allow update: if isSignedIn() && isExistingOwner(resource.data.userId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.userId);
    }

    /**
     * @description Allows users to read and write metrics data where they are the owner.
     * @path /metrics/{metricsId}
     * @allow (create) User with UID 'user123' can create metrics data at /metrics/user123 if request.resource.data.userId == 'user123'.
     * @allow (get, update, delete) User with UID 'user123' can read/update/delete metrics data at /metrics/user123 if the existing document's userId == 'user123'.
     * @deny (create) User with UID 'user456' cannot create metrics data at /metrics/user123 with request.resource.data.userId == 'user123'.
     * @deny (get, update, delete) User with UID 'user456' cannot read/update/delete metrics data at /metrics/user123 if the existing document's userId == 'user123'.
     * @principle Enforces document ownership based on the userId field.
     */
    match /metrics/{metricsId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

       function isExistingOwner(userId) {
        return isSignedIn() && resource.data.userId == request.auth.uid;
      }

      allow get: if isSignedIn() && isExistingOwner(resource.data.userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      allow update: if isSignedIn() && isExistingOwner(resource.data.userId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.userId);
    }

    /**
     * @description Allows users to read and write coaching history where they are the owner.
     * @path /coachingHistory/{historyId}
     * @allow (create) User with UID 'user123' can create coaching history at /coachingHistory/history456 if request.resource.data.userId == 'user123'.
     * @allow (get, update, delete) User with UID 'user123' can read/update/delete coaching history at /coachingHistory/history456 if the existing document's userId == 'user123'.
     * @deny (create) User with UID 'user456' cannot create coaching history at /coachingHistory/history456 with request.resource.data.userId == 'user123'.
     * @deny (get, update, delete) User with UID 'user456' cannot read/update/delete coaching history at /coachingHistory/history456 if the existing document's userId == 'user123'.
     * @principle Enforces document ownership based on the userId field.
     */
    match /coachingHistory/{historyId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

       function isExistingOwner(userId) {
        return isSignedIn() && resource.data.userId == request.auth.uid;
      }

      allow get: if isSignedIn() && isExistingOwner(resource.data.userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      allow update: if isSignedIn() && isExistingOwner(resource.data.userId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.userId);
    }

    /**
     * @description Allows users to read and write tool usage logs where they are the owner.
     * @path /toolUsageLogs/{logId}
     * @allow (create) User with UID 'user123' can create a tool usage log at /toolUsageLogs/log456 if request.resource.data.userId == 'user123'.
     * @allow (get, update, delete) User with UID 'user123' can read/update/delete a tool usage log at /toolUsageLogs/log456 if the existing document's userId == 'user123'.
     * @deny (create) User with UID 'user456' cannot create a tool usage log at /toolUsageLogs/log456 with request.resource.data.userId == 'user123'.
     * @deny (get, update, delete) User with UID 'user456' cannot read/update/delete a tool usage log at /toolUsageLogs/log456 if the existing document's userId == 'user123'.
     * @principle Enforces document ownership based on the userId field.
     */
    match /toolUsageLogs/{logId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

       function isExistingOwner(userId) {
        return isSignedIn() && resource.data.userId == request.auth.uid;
      }

      allow get: if isSignedIn() && isExistingOwner(resource.data.userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      allow update: if isSignedIn() && isExistingOwner(resource.data.userId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.userId);
    }
  }
}