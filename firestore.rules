/**
 * @fileoverview Firestore Security Rules for SoloStrategist OS.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Each user has full
 * control over their own data, and no access to other users' data.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information.
 * - /users/{userId}/tasks/{taskId}: Stores tasks associated with a user.
 * - /users/{userId}/metrics/{metricId}: Stores metrics data for a user.
 * - /users/{userId}/coachingHistory/{historyId}: Stores coaching history.
 * - /users/{userId}/toolUsageLogs/{logId}: Stores tool usage logs.
 *
 * Key Security Decisions:
 * - User data is strictly segregated based on `userId`.
 * - Users can only create, read, update, and delete data under their own `userId`.
 * - No listing of all users is allowed.
 * - Authorization relies on the `request.auth.uid` being equal to the `userId`
 *   in the path.
 *
 * Denormalization for Authorization:
 *  - The `userId` is embedded in all subcollection paths, which makes it easy
 *    to validate ownership using `isOwner(userId)`.
 * Structural Segregation:
 *  - All private data is kept under the `/users/{userId}` path, ensuring
 *    clear separation from any potential public data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     * @param {string} userId - The user ID to check against.
     * @return {bool} True if the user is signed in and the UID matches, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the existing owner of the document.
     * @param {string} userId - The user ID to check against.
     * @return {bool} True if the user is signed in, the UID matches, and the resource exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && exists(resource);
    }

    /**
     * @description Enforces that the ID field within a document matches the document ID.
     * @param {string} documentId - The expected ID of the document
     * @return {bool} True if the document ID matches, false otherwise.
     */
    function isValidDocumentId(documentId) {
        return request.resource.data.id == documentId;
    }
   /**
     * @description
     *   - Protects the root user profile document at `/users/{userId}`.
     *   - Allows a user to create their own profile, and then read, update, and delete it.
     * @path /databases/{database}/documents/users/{userId}
     * @allow (create) - User with UID 'user123' can create a profile at /users/user123 if request.auth.uid == 'user123'
     * @allow (get) - User with UID 'user123' can get their profile at /users/user123 if request.auth.uid == 'user123'
     * @allow (update) - User with UID 'user123' can update their profile at /users/user123 if request.auth.uid == 'user123'
     * @allow (delete) - User with UID 'user123' can delete their profile at /users/user123 if request.auth.uid == 'user123'
     * @deny (create) - User with UID 'user456' cannot create a profile at /users/user123
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description
     *   - Protects the task documents at `/users/{userId}/tasks/{taskId}`.
     *   - Allows a user to create, read, update, and delete tasks associated with their profile.
     * @path /databases/{database}/documents/users/{userId}/tasks/{taskId}
     * @allow (create) - User with UID 'user123' can create a task at /users/user123/tasks/task1 if request.auth.uid == 'user123'
     * @allow (get) - User with UID 'user123' can get their task at /users/user123/tasks/task1 if request.auth.uid == 'user123'
     * @allow (update) - User with UID 'user123' can update their task at /users/user123/tasks/task1 if request.auth.uid == 'user123'
     * @allow (delete) - User with UID 'user123' can delete their task at /users/user123/tasks/task1 if request.auth.uid == 'user123'
     * @deny (create) - User with UID 'user456' cannot create a task at /users/user123/tasks/task1
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/tasks/{taskId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description
     *   - Protects the metrics documents at `/users/{userId}/metrics/{metricId}`.
     *   - Allows a user to create, read, update, and delete metrics associated with their profile.
     * @path /databases/{database}/documents/users/{userId}/metrics/{metricId}
     * @allow (create) - User with UID 'user123' can create metrics at /users/user123/metrics/metrics1 if request.auth.uid == 'user123'
     * @allow (get) - User with UID 'user123' can get their metrics at /users/user123/metrics/metrics1 if request.auth.uid == 'user123'
     * @allow (update) - User with UID 'user123' can update their metrics at /users/user123/metrics/metrics1 if request.auth.uid == 'user123'
     * @allow (delete) - User with UID 'user123' can delete their metrics at /users/user123/metrics/metrics1 if request.auth.uid == 'user123'
     * @deny (create) - User with UID 'user456' cannot create metrics at /users/user123/metrics/metrics1
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/metrics/{metricId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description
     *   - Protects the coaching history documents at `/users/{userId}/coachingHistory/{historyId}`.
     *   - Allows a user to create, read, update, and delete coaching history associated with their profile.
     * @path /databases/{database}/documents/users/{userId}/coachingHistory/{historyId}
     * @allow (create) - User with UID 'user123' can create coaching history at /users/user123/coachingHistory/history1 if request.auth.uid == 'user123'
     * @allow (get) - User with UID 'user123' can get their coaching history at /users/user123/coachingHistory/history1 if request.auth.uid == 'user123'
     * @allow (update) - User with UID 'user123' can update their coaching history at /users/user123/coachingHistory/history1 if request.auth.uid == 'user123'
     * @allow (delete) - User with UID 'user123' can delete their coaching history at /users/user123/coachingHistory/history1 if request.auth.uid == 'user123'
     * @deny (create) - User with UID 'user456' cannot create coaching history at /users/user123/coachingHistory/history1
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/coachingHistory/{historyId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description
     *   - Protects the tool usage log documents at `/users/{userId}/toolUsageLogs/{logId}`.
     *   - Allows a user to create, read, update, and delete tool usage logs associated with their profile.
     * @path /databases/{database}/documents/users/{userId}/toolUsageLogs/{logId}
     * @allow (create) - User with UID 'user123' can create a tool usage log at /users/user123/toolUsageLogs/log1 if request.auth.uid == 'user123'
     * @allow (get) - User with UID 'user123' can get their tool usage log at /users/user123/toolUsageLogs/log1 if request.auth.uid == 'user123'
     * @allow (update) - User with UID 'user123' can update their tool usage log at /users/user123/toolUsageLogs/log1 if request.auth.uid == 'user123'
     * @allow (delete) - User with UID 'user123' can delete their tool usage log at /users/user123/toolUsageLogs/log1 if request.auth.uid == 'user123'
     * @deny (create) - User with UID 'user456' cannot create a tool usage log at /users/user123/toolUsageLogs/log1
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/toolUsageLogs/{logId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
   /**
     * @description
     *   - Protects the businessProfile document at `/users/{userId}/businessProfile/data`.
     *   - Allows a user to create, read, update, and delete businessProfile associated with their profile.
     * @path /databases/{database}/documents/users/{userId}/businessProfile/data
     * @allow (create) - User with UID 'user123' can create a businessProfile at /users/user123/businessProfile/data if request.auth.uid == 'user123'
     * @allow (get) - User with UID 'user123' can get their businessProfile at /users/user123/businessProfile/data if request.auth.uid == 'user123'
     * @allow (update) - User with UID 'user123' can update their businessProfile at /users/user123/businessProfile/data if request.auth.uid == 'user123'
     * @allow (delete) - User with UID 'user123' can delete their businessProfile at /users/user123/businessProfile/data if request.auth.uid == 'user123'
     * @deny (create) - User with UID 'user456' cannot create a businessProfile at /users/user123/businessProfile/data
     * @principle Enforces document ownership for all operations.
     */
      match /users/{userId}/businessProfile/data {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
  }
}