/**
 * @file Firestore Security Rules
 * @version 2
 *
 * @description
 * This ruleset enforces a strict user-ownership model for all data within the SoloStrategist OS.
 * Each user has a dedicated data tree under `/users/{userId}`, and only the authenticated user
 * matching that `userId` can read or write data within that tree.
 *
 * Data Structure:
 * - /users/{userId}: User profile information.
 * - /users/{userId}/tasks/{taskId}: Tasks associated with a user.
 * - /users/{userId}/metrics/{metricId}: Metrics data for a user.
 * - /users/{userId}/coachingHistory/{historyId}: Coaching history for a user.
 * - /users/{userId}/toolUsageLogs/{logId}: Tool usage logs for a user.
 *
 * Key Security Decisions:
 * - Strict user-ownership: All data is protected by the `isOwner(userId)` function, ensuring that only the authenticated user can access their own data.
 * - No user listing: Listing the `/users` collection is disallowed.
 * - Subcollection Access: Subcollections inherit the ownership constraints from their parent user document.
 *
 * Denormalization for Authorization: N/A (Ownership is determined by the path itself)
 * Structural Segregation: N/A (All private user data is stored under `/users/{userId}`)
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by an authenticated user.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     * @param {string} userId The user ID to compare against the authenticated user's ID.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the existing owner of the document.
     * @param {string} userId The user ID to compare against the authenticated user's ID.
     * @return {boolean} True if the user is the owner and the document exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Root-level read permissions are denied. Prevents listing all users.
     * @path /users
     * @allow (get) - N/A (Not applicable to the root level)
     * @deny (list) - Attempt to list all user documents.
     * @principle Prevents unauthorized listing of user profiles.
     */
    match /users {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages access to user profile documents.
     * @path /users/{userId}
     * @allow (create) - User creates their own profile with matching UID.
     * @allow (get, list, update, delete) - Only the user with the matching UID can access their profile.
     * @deny (create) - If the user attempts to create a profile with a mismatched UID.
     * @principle Enforces user-ownership for profile data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Listing user documents is not allowed.
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages access to tasks associated with a specific user.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (get, list, create, update, delete) - Only the user with the matching UID can access their tasks.
     * @deny (create) - If the task is created with a mismatched userProfileId.
     * @principle Enforces user-ownership for task data.
     */
    match /users/{userId}/tasks/{taskId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages access to metrics data associated with a specific user.
     * @path /users/{userId}/metrics/{metricId}
     * @allow (get, list, create, update, delete) - Only the user with the matching UID can access their metrics.
     * @deny (create) - If the metrics data is created with a mismatched userProfileId.
     * @principle Enforces user-ownership for metrics data.
     */
    match /users/{userId}/metrics/{metricId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages access to coaching history for a specific user.
     * @path /users/{userId}/coachingHistory/{historyId}
     * @allow (get, list, create, update, delete) - Only the user with the matching UID can access their coaching history.
     * @deny (create) - If the coaching history is created with a mismatched userProfileId.
     * @principle Enforces user-ownership for coaching history data.
     */
    match /users/{userId}/coachingHistory/{historyId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages access to tool usage logs for a specific user.
     * @path /users/{userId}/toolUsageLogs/{logId}
     * @allow (get, list, create, update, delete) - Only the user with the matching UID can access their tool usage logs.
     * @deny (create) - If the tool usage log is created with a mismatched userProfileId.
     * @principle Enforces user-ownership for tool usage log data.
     */
    match /users/{userId}/toolUsageLogs/{logId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Handles business profile data, a subcollection of user profiles.
     * @path /users/{userId}/businessProfile/data
     * @allow (get) - Allows the owner to read their business profile data.
     * @allow (list, create, update, delete) - Restricts all other operations.
     * @deny (any) - Any other operations.
     * @principle Enforces user-ownership for profile data, limiting access to read-only for the owner.
     */
    match /users/{userId}/businessProfile/data {
        allow get: if isOwner(userId);
        allow list: if false;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }
  }
}