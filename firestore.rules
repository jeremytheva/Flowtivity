/**
 * @fileoverview Firestore Security Rules for SoloStrategist OS.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Each user has a dedicated data tree under /users/{userId},
 * and only the authenticated user with a matching ID can read and write to that data. This ensures data privacy
 * and prevents unauthorized access.
 *
 * Data Structure:
 * All data is nested under /users/{userId}, creating a clear hierarchy:
 * - /users/{userId}: UserProfile data
 * - /users/{userId}/tasks/{taskId}: Tasks for each user
 * - /users/{userId}/metrics/{metricId}: Metrics data for each user
 * - /users/{userId}/coachingHistory/{historyId}: AI coaching history for each user
 * - /users/{userId}/toolUsageLogs/{logId}: Tool usage logs to help identify potential money leaks
 *
 * Key Security Decisions:
 * - User listing is disallowed to prevent potential information leakage.
 * - All write operations are strictly controlled by the `isOwner()` function, ensuring that only the
 *   authenticated user can modify their own data.
 * - Data consistency is enforced by validating the userProfileId field against the userId path parameter
 *   on create operations.  This prevents users from creating data in other users' data trees.
 * - Immutability is enforced for the userProfileId field on update operations, preventing users from
 *   transferring ownership of data to another user.
 *
 * Denormalization for Authorization:
 *  N/A - The data structure is designed to be user-centric, and the `isOwner()` check is sufficient
 *  for most authorization decisions. There are no `get()` operations on other collections to determine access.
 *
 * Structural Segregation:
 *  N/A - There is no public data in this data model. All user data is private and stored under the /users/{userId} path.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by the owner of the resource.
     * @param {string} userId - The user ID to check against the request's authentication UID.
     * @return {boolean} - True if the user is signed in and the UID matches the userId, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} - True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is an existing owner of the resource.
     * @param {string} userId - The user ID to check against the request's authentication UID.
     * @return {boolean} - True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Enforces user-ownership for profile data. Only the authenticated user can
     *              read and write their own profile data.
     * @path /users/{userId}
     * @allow (get) - User with ID 'user123' can read their own profile.
     *                  Example: `auth.uid == 'user123'`
     * @allow (create) - User with ID 'user456' can create their own profile.
     *                     Example: `auth.uid == 'user456'`
     * @allow (update) - User with ID 'user789' can update their own profile.
     *                     Example: `auth.uid == 'user789'`
     * @allow (delete) - User with ID 'userabc' can delete their own profile.
     *                     Example: `auth.uid == 'userabc'`
     * @deny (get) - User with ID 'user123' cannot read another user's profile ('user456').
     *                 Example: `auth.uid == 'user123', userId == 'user456'`
     * @deny (create) - User with ID 'user123' cannot create a profile for another user ('user456').
     *                    Example: `auth.uid == 'user123', userId == 'user456'`
     * @deny (update) - User with ID 'user123' cannot update another user's profile ('user456').
     *                    Example: `auth.uid == 'user123', userId == 'user456'`
     * @deny (delete) - User with ID 'user123' cannot delete another user's profile ('user456').
     *                    Example: `auth.uid == 'user123', userId == 'user456'`
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Listing users is not permitted.
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces user-ownership for tasks. Only the authenticated user can
     *              read and write their own tasks.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (get) - User with ID 'user123' can read their own task.
     *                  Example: `auth.uid == 'user123'`
     * @allow (create) - User with ID 'user456' can create a task for themselves.
     *                     Example: `auth.uid == 'user456'`
     * @allow (update) - User with ID 'user789' can update their own task.
     *                     Example: `auth.uid == 'user789'`
     * @allow (delete) - User with ID 'userabc' can delete their own task.
     *                     Example: `auth.uid == 'userabc'`
     * @deny (get) - User with ID 'user123' cannot read another user's task.
     *                 Example: `auth.uid == 'user123', userId == 'user456'`
     * @deny (create) - User with ID 'user123' cannot create a task for another user.
     *                    Example: `auth.uid == 'user123', userId == 'user456'`
     * @deny (update) - User with ID 'user123' cannot update another user's task.
     *                    Example: `auth.uid == 'user123', userId == 'user456'`
     * @deny (delete) - User with ID 'user123' cannot delete another user's task.
     *                    Example: `auth.uid == 'user123', userId == 'user456'`
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/tasks/{taskId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userProfileId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userProfileId == resource.data.userProfileId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces user-ownership for metrics data. Only the authenticated user can
     *              read and write their own metrics data.
     * @path /users/{userId}/metrics/{metricId}
     * @allow (get) - User with ID 'user123' can read their own metrics data.
     *                  Example: `auth.uid == 'user123'`
     * @allow (create) - User with ID 'user456' can create metrics data for themselves.
     *                     Example: `auth.uid == 'user456'`
     * @allow (update) - User with ID 'user789' can update their own metrics data.
     *                     Example: `auth.uid == 'user789'`
     * @allow (delete) - User with ID 'userabc' can delete their own metrics data.
     *                     Example: `auth.uid == 'userabc'`
     * @deny (get) - User with ID 'user123' cannot read another user's metrics data.
     *                 Example: `auth.uid == 'user123', userId == 'user456'`
     * @deny (create) - User with ID 'user123' cannot create metrics data for another user.
     *                    Example: `auth.uid == 'user123', userId == 'user456'`
     * @deny (update) - User with ID 'user123' cannot update another user's metrics data.
     *                    Example: `auth.uid == 'user123', userId == 'user456'`
     * @deny (delete) - User with ID 'user123' cannot delete another user's metrics data.
     *                    Example: `auth.uid == 'user123', userId == 'user456'`
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/metrics/{metricId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userProfileId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userProfileId == resource.data.userProfileId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces user-ownership for coaching history. Only the authenticated user can
     *              read and write their own coaching history.
     * @path /users/{userId}/coachingHistory/{historyId}
     * @allow (get) - User with ID 'user123' can read their own coaching history.
     *                  Example: `auth.uid == 'user123'`
     * @allow (create) - User with ID 'user456' can create coaching history for themselves.
     *                     Example: `auth.uid == 'user456'`
     * @allow (update) - User with ID 'user789' can update their own coaching history.
     *                     Example: `auth.uid == 'user789'`
     * @allow (delete) - User with ID 'userabc' can delete their own coaching history.
     *                     Example: `auth.uid == 'userabc'`
     * @deny (get) - User with ID 'user123' cannot read another user's coaching history.
     *                 Example: `auth.uid == 'user123', userId == 'user456'`
     * @deny (create) - User with ID 'user123' cannot create coaching history for another user.
     *                    Example: `auth.uid == 'user123', userId == 'user456'`
     * @deny (update) - User with ID 'user123' cannot update another user's coaching history.
     *                    Example: `auth.uid == 'user123', userId == 'user456'`
     * @deny (delete) - User with ID 'user123' cannot delete another user's coaching history.
     *                    Example: `auth.uid == 'user123', userId == 'user456'`
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/coachingHistory/{historyId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userProfileId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userProfileId == resource.data.userProfileId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces user-ownership for tool usage logs. Only the authenticated user can
     *              read and write their own tool usage logs.
     * @path /users/{userId}/toolUsageLogs/{logId}
     * @allow (get) - User with ID 'user123' can read their own tool usage log.
     *                  Example: `auth.uid == 'user123'`
     * @allow (create) - User with ID 'user456' can create a tool usage log for themselves.
     *                     Example: `auth.uid == 'user456'`
     * @allow (update) - User with ID 'user789' can update their own tool usage log.
     *                     Example: `auth.uid == 'user789'`
     * @allow (delete) - User with ID 'userabc' can delete their own tool usage log.
     *                     Example: `auth.uid == 'userabc'`
     * @deny (get) - User with ID 'user123' cannot read another user's tool usage log.
     *                 Example: `auth.uid == 'user123', userId == 'user456'`
     * @deny (create) - User with ID 'user123' cannot create a tool usage log for another user.
     *                    Example: `auth.uid == 'user123', userId == 'user456'`
     * @deny (update) - User with ID 'user123' cannot update another user's tool usage log.
     *                    Example: `auth.uid == 'user123', userId == 'user456'`
     * @deny (delete) - User with ID 'user123' cannot delete another user's tool usage log.
     *                    Example: `auth.uid == 'user123', userId == 'user456'`
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/toolUsageLogs/{logId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userProfileId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userProfileId == resource.data.userProfileId;
      allow delete: if isExistingOwner(userId);
    }

      /**
       * @description Adding the following match block to provide the necessary permissions for creating the business profile data, which the app was missing.
       * @path /users/{userId}/businessProfile/data
       * @allow (create) - Allows the creation of business profile data if the user is the owner.
       * @deny (get) - Denies getting the business profile data.
       * @deny (list) - Denies listing the business profile data.
       * @deny (update) - Denies updating the business profile data.
       * @deny (delete) - Denies deleting the business profile data.
       */
      match /users/{userId}/businessProfile/data {
          allow get: if false;
          allow list: if false;
          allow create: if isOwner(userId);
          allow update: if false;
          allow delete: if false;
      }
  }
}