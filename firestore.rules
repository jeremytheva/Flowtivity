/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for the SoloStrategist OS application.
 *
 * Data Structure:
 * All data is nested under /userProfiles/{userProfileId}, ensuring that each user's data is isolated and access-controlled.
 * Subcollections under each user profile (tasks, metricsData, coachingHistory, toolUsageLogs) inherit this ownership.
 *
 * Key Security Decisions:
 * - Users can only access their own profile data and associated subcollections.
 * - Listing other users' data is explicitly disallowed.
 * - Data validation is minimal in this prototyping phase, focusing on ownership and relational integrity.
 *
 * Denormalization for Authorization:
 * The data structure is designed for path-based ownership, so all authorization checks are based on the `request.auth.uid` matching the `userProfileId` in the path.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects user profile documents. Only the owner can read and write.
     * @path /userProfiles/{userProfileId}
     * @allow (get, create, update, delete) if the request is made by the owner of the profile.
     * @deny (get, create, update, delete) if the request is made by someone other than the owner.
     * @principle Enforces document ownership for all operations.
     */
    match /userProfiles/{userProfileId} {
      // Helper function to check if the user is signed in.
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the user is the owner of the profile.
      function isOwner(userProfileId) {
        return isSignedIn() && request.auth.uid == userProfileId;
      }

      // Helper function to check if the user is the owner of the existing profile.
      function isExistingOwner(userProfileId) {
        return isOwner(userProfileId) && resource.data != null;
      }

      // Allows a user to read their own profile.
      allow get: if isOwner(userProfileId);

      // Only the owner can list user profiles.  This is generally not desirable.
      allow list: if false;

      // Allows a user to create their own profile if the ID matches their auth UID.
      allow create: if isOwner(userProfileId);

      // Allows the owner to update their own profile. Enforces immutability of the 'id' field.
      allow update: if isExistingOwner(userProfileId);

      // Allows the owner to delete their own profile.
      allow delete: if isExistingOwner(userProfileId);

      match /tasks/{taskId} {
        allow get: if isSignedIn() && request.auth.uid == userProfileId;
        allow list: if isSignedIn() && request.auth.uid == userProfileId;
        allow create: if isSignedIn() && request.auth.uid == userProfileId;
        allow update: if isSignedIn() && request.auth.uid == userProfileId;
        allow delete: if isSignedIn() && request.auth.uid == userProfileId;
      }

      match /metricsData/{metricsDataId} {
        allow get: if isSignedIn() && request.auth.uid == userProfileId;
        allow list: if isSignedIn() && request.auth.uid == userProfileId;
        allow create: if isSignedIn() && request.auth.uid == userProfileId;
        allow update: if isSignedIn() && request.auth.uid == userProfileId;
        allow delete: if isSignedIn() && request.auth.uid == userProfileId;
      }

      match /coachingHistory/{coachingHistoryId} {
        allow get: if isSignedIn() && request.auth.uid == userProfileId;
        allow list: if isSignedIn() && request.auth.uid == userProfileId;
        allow create: if isSignedIn() && request.auth.uid == userProfileId;
        allow update: if isSignedIn() && request.auth.uid == userProfileId;
        allow delete: if isSignedIn() && request.auth.uid == userProfileId;
      }

      match /toolUsageLogs/{toolUsageLogId} {
        allow get: if isSignedIn() && request.auth.uid == userProfileId;
        allow list: if isSignedIn() && request.auth.uid == userProfileId;
        allow create: if isSignedIn() && request.auth.uid == userProfileId;
        allow update: if isSignedIn() && request.auth.uid == userProfileId;
        allow delete: if isSignedIn() && request.auth.uid == userProfileId;
      }
    }
  }
}