/**
 * @fileoverview Firestore Security Rules for SoloStrategist OS.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Each user can only access their own data.
 *
 * Data Structure:
 * All data is nested under /users/{userId}, ensuring data isolation between users.
 * - /users/{userId}: Stores user profile information.
 * - /users/{userId}/tasks/{taskId}: Stores tasks associated with a user.
 * - /users/{userId}/metrics/{metricId}: Stores metrics data associated with a user.
 * - /users/{userId}/coachingHistory/{historyId}: Stores AI coaching history.
 * - /users/{userId}/toolUsageLogs/{logId}: Stores tool usage logs for identifying money leaks.
 *
 * Key Security Decisions:
 * - User data is strictly segregated, with each user having exclusive access to their own data.
 * - No user listing is allowed to prevent information disclosure.
 * - Self-creation is allowed for the `/users/{userId}` document, enabling new user registration.
 *
 * Denormalization for Authorization:
 *  The `userProfileId` field is present on Task, MetricsData, CoachingHistory, and ToolUsageLog documents. This denormalization enables simple, efficient ownership checks without requiring additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces user-ownership for UserProfile documents. Only the authenticated user can read, update, or delete their own profile.
     * @path /users/{userId}
     * @allow (create) - Authenticated user creates their own profile with matching userId.
     * @allow (get, update, delete) - Authenticated user accesses their own profile.
     * @deny (create) - Authenticated user attempts to create a profile with a mismatched userId.
     * @deny (get, update, delete) - Authenticated user attempts to access another user's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces user-ownership for Task documents within a user's profile. Only the authenticated user can manage their own tasks.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (create, get, update, delete, list) - Authenticated user manages their own tasks.
     * @deny (create, get, update, delete, list) - Authenticated user attempts to access another user's tasks.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/tasks/{taskId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userProfileId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userProfileId == resource.data.userProfileId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces user-ownership for MetricsData documents within a user's profile. Only the authenticated user can access their own metrics data.
     * @path /users/{userId}/metrics/{metricId}
     * @allow (create, get, update, delete, list) - Authenticated user manages their own metrics data.
     * @deny (create, get, update, delete, list) - Authenticated user attempts to access another user's metrics data.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/metrics/{metricId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userProfileId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userProfileId == resource.data.userProfileId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces user-ownership for CoachingHistory documents within a user's profile. Only the authenticated user can access their own coaching history.
     * @path /users/{userId}/coachingHistory/{historyId}
     * @allow (create, get, update, delete, list) - Authenticated user manages their own coaching history.
     * @deny (create, get, update, delete, list) - Authenticated user attempts to access another user's coaching history.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/coachingHistory/{historyId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userProfileId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userProfileId == resource.data.userProfileId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces user-ownership for ToolUsageLog documents within a user's profile. Only the authenticated user can access their own tool usage logs.
     * @path /users/{userId}/toolUsageLogs/{logId}
     * @allow (create, get, update, delete, list) - Authenticated user manages their own tool usage logs.
     * @deny (create, get, update, delete, list) - Authenticated user attempts to access another user's tool usage logs.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/toolUsageLogs/{logId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userProfileId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userProfileId == resource.data.userProfileId;
      allow delete: if isExistingOwner(userId);
    }
  }
}