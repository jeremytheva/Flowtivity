/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for all data.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, keyed by their UID.
 * - /tasks/{taskId}: Stores tasks for all users. Each task document MUST contain a 'userId' field.
 * - /metrics/{userId}: Stores metrics data, keyed by user UID.
 * - /coachingHistory/{historyId}: Stores coaching history, indexed by userId.
 * - /toolUsageLogs/{logId}: Stores tool usage logs, indexed by userId.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data in /users/{userId}.
 * - Tasks can be created by anyone, but only the owner (specified by the 'userId' field) can update or delete them. Listing all tasks is disallowed.
 * - Metrics data can only be read and written by the owner.
 * - Coaching history can only be read and written by the owner. Listing all entries is disallowed.
 * - Tool usage logs can only be read and written by the owner. Listing all entries is disallowed.
 * - Listing of users is disallowed.
 *
 * Denormalization for Authorization:
 * - Tasks include a `userId` field to enable ownership checks without additional reads.
 * - Metrics, CoachingHistory, and ToolUsageLog include a `userId` field to enable ownership checks without additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their profile if request.auth.uid == 'user123'.
     * @allow (update) User with UID 'user123' can update their profile.
     * @allow (get) User with UID 'user123' can get their profile.
     * @deny (create) User with UID 'user456' cannot create a profile for 'user123'.
     * @deny (update) User with UID 'user456' cannot update profile 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to tasks.
     * @path /tasks/{taskId}
     * @allow (create) User with UID 'user123' can create a task with userId 'user123'.
     * @allow (update) User with UID 'user123' can update a task they own (resource.data.userId == 'user123').
     * @allow (get) Any user can get any task
     * @deny (create) User with UID 'user456' cannot create a task with userId 'user123'.
     * @deny (update) User with UID 'user456' cannot update a task owned by 'user123'.
     * @principle Enforces document ownership for writes, open reads.
     */
    match /tasks/{taskId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.userId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.userId);
      allow delete: if isExistingOwner(resource.data.userId);
    }

    /**
     * @description Controls access to metrics data.
     * @path /metrics/{userId}
     * @allow (create) User with UID 'user123' can create metrics data for themselves.
     * @allow (update) User with UID 'user123' can update their own metrics data.
     * @allow (get) User with UID 'user123' can get their own metrics data.
     * @deny (create) User with UID 'user456' cannot create metrics data for 'user123'.
     * @deny (update) User with UID 'user456' cannot update metrics data for 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /metrics/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to coaching history.
     * @path /coachingHistory/{historyId}
     * @allow (create) User with UID 'user123' can create coaching history for themselves.
     * @allow (update) User with UID 'user123' can update their own coaching history.
     * @allow (get) User with UID 'user123' can get their own coaching history.
     * @deny (create) User with UID 'user456' cannot create coaching history for 'user123'.
     * @deny (update) User with UID 'user456' cannot update coaching history for 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /coachingHistory/{historyId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
       function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(resource.data.userId);
      allow list: if false;
      allow create: if request.resource.data.userId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.userId);
      allow delete: if isExistingOwner(resource.data.userId);
    }

    /**
     * @description Controls access to tool usage logs.
     * @path /toolUsageLogs/{logId}
     * @allow (create) User with UID 'user123' can create tool usage logs for themselves.
     * @allow (update) User with UID 'user123' can update their own tool usage logs.
     * @allow (get) User with UID 'user123' can get their own tool usage logs.
     * @deny (create) User with UID 'user456' cannot create tool usage logs for 'user123'.
     * @deny (update) User with UID 'user456' cannot update tool usage logs for 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /toolUsageLogs/{logId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(resource.data.userId);
      allow list: if false;
      allow create: if request.resource.data.userId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.userId);
      allow delete: if isExistingOwner(resource.data.userId);
    }
  }
}