rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by an authenticated user.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Requires authentication for all operations.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Enforces user ownership.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner and the resource exists.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Combines ownership and existence checks for destructive operations.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && exists(/databases/$(database)/documents/users/$(userId));
    }

    /**
     * @description Enforces that the incoming userProfileId on create matches the userId in the path
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Enforces relationship integrity between documents.
     */
    function isValidUserProfileIdOnCreate(userId) {
      return request.resource.data.userProfileId == userId;
    }

    /**
     * @description Enforces that the userProfileId field is immutable.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Enforces immutability of key relational fields.
     */
    function isValidUserProfileIdOnUpdate(userId) {
      return request.resource.data.userProfileId == resource.data.userProfileId;
    }

    /**
     * @description Rules for user profile documents.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' creates their own profile.
     * @allow (get) User with ID 'user123' retrieves their profile.
     * @allow (update) User with ID 'user123' updates their profile.
     * @allow (delete) User with ID 'user123' deletes their profile.
     * @deny (create) User with ID 'user123' tries to create a profile for 'user456'.
     * @deny (get) User with ID 'user123' tries to retrieve the profile of 'user456'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId) ;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Rules for tasks within a user's profile.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (create) User with ID 'user123' creates a task within their profile.
     * @allow (get) User with ID 'user123' retrieves a task within their profile.
     * @allow (update) User with ID 'user123' updates a task within their profile.
     * @allow (delete) User with ID 'user123' deletes a task within their profile.
     * @deny (create) User with ID 'user123' tries to create a task for 'user456'.
     * @deny (get) User with ID 'user123' tries to retrieve a task from 'user456'.
     * @principle Enforces document ownership for all operations within the tasks subcollection.
     */
    match /users/{userId}/tasks/{taskId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Rules for metrics data within a user's profile.
     * @path /users/{userId}/metrics/{metricId}
     * @allow (create) User with ID 'user123' creates metrics data within their profile.
     * @allow (get) User with ID 'user123' retrieves metrics data within their profile.
     * @allow (update) User with ID 'user123' updates metrics data within their profile.
     * @allow (delete) User with ID 'user123' deletes metrics data within their profile.
     * @deny (create) User with ID 'user123' tries to create metrics data for 'user456'.
     * @deny (get) User with ID 'user123' tries to retrieve metrics data from 'user456'.
     * @principle Enforces document ownership for all operations within the metrics subcollection.
     */
    match /users/{userId}/metrics/{metricId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Rules for coaching history within a user's profile.
     * @path /users/{userId}/coachingHistory/{historyId}
     * @allow (create) User with ID 'user123' creates coaching history within their profile.
     * @allow (get) User with ID 'user123' retrieves coaching history within their profile.
     * @allow (update) User with ID 'user123' updates coaching history within their profile.
     * @allow (delete) User with ID 'user123' deletes coaching history within their profile.
     * @deny (create) User with ID 'user123' tries to create coaching history for 'user456'.
     * @deny (get) User with ID 'user123' tries to retrieve coaching history from 'user456'.
     * @principle Enforces document ownership for all operations within the coaching history subcollection.
     */
    match /users/{userId}/coachingHistory/{historyId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Rules for tool usage logs within a user's profile.
     * @path /users/{userId}/toolUsageLogs/{logId}
     * @allow (create) User with ID 'user123' creates tool usage logs within their profile.
     * @allow (get) User with ID 'user123' retrieves tool usage logs within their profile.
     * @allow (update) User with ID 'user123' updates tool usage logs within their profile.
     * @allow (delete) User with ID 'user123' deletes tool usage logs within their profile.
     * @deny (create) User with ID 'user123' tries to create tool usage logs for 'user456'.
     * @deny (get) User with ID 'user123' tries to retrieve tool usage logs from 'user456'.
     * @principle Enforces document ownership for all operations within the tool usage logs subcollection.
     */
    match /users/{userId}/toolUsageLogs/{logId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
  }
}